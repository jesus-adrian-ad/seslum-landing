# Copia este archivo a .env.local para desarrollo. Los valores reales NUNCA se
# commitean: viven en el gestor de contraseñas de YiSoft, en las variables del
# repo de GitHub y en la configuración de Cloudflare Pages.

# Entorno del build: "production" solo para main. Cualquier otro valor = staging
# (sitio no indexable).
NEXT_PUBLIC_SITE_ENV=staging

# Contenedor de Google Tag Manager (GTM-XXXXXXX). Público por diseño: viaja en el
# HTML. Vacío = no se carga GTM.
NEXT_PUBLIC_GTM_ID=

# Solo staging: URL pública del alias de la rama en Cloudflare Pages
# (https://<rama>.seslum-landing.pages.dev). La calcula el workflow; en local
# puede quedar vacía y se usa el dominio canónico.
NEXT_PUBLIC_SITE_URL=

# Formulario de contacto: clave pública del widget de Turnstile. Obligatoria en
# producción; vacía en staging o en local = clave de prueba de Cloudflare.
# Los secretos de la Pages Function van en .dev.vars (ver .dev.vars.example),
# nunca aquí.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
