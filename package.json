{
  "name": "seslum-landing",
  "version": "0.1.0",
  "private": true,
  "description": "Landing page de Grupo SESLUM \u2014 desarrollada por YiSoft Development.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/inline-structured-data.mjs && node scripts/defer-hydration.mjs && node scripts/csp-hashes.mjs",
    "build:audit": "NEXT_PUBLIC_SITE_ENV=production npm run build",
    "preview": "wrangler pages dev out --port 8788",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit:gate": "node scripts/audit-gate.mjs",
    "images:strip": "node scripts/strip-image-metadata.mjs",
    "images:check": "node scripts/strip-image-metadata.mjs --check",
    "og:image": "node scripts/og-image.mjs",
    "verify": "./scripts/verify-block.sh --dist out --url http://localhost:8788"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2",
    "wrangler": "^4.143.0"
  },
  "overrides": {
    "undici": "^7.30.0"
  }
}
