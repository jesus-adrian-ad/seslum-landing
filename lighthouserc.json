{
  "_comment": "Copiar a la raíz del repo como lighthouserc.json. Umbral del método: >= 90 en las cuatro categorías, medido en móvil. Tres corridas y mediana, porque una sola tiene demasiada varianza y un falso rojo hace perder un ciclo de revisión.",
  "ci": {
    "collect": {
      "staticDistDir": "./out",
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "throttlingMethod": "simulate",
        "screenEmulation": {
          "mobile": true,
          "width": 412,
          "height": 823,
          "deviceScaleFactor": 1.75,
          "disabled": false
        },
        "skipAudits": [
          "uses-http2",
          "canonical"
        ]
      },
      "url": [
        "http://localhost/index.html"
      ]
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 200
          }
        ],
        "first-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 1800
          }
        ],
        "speed-index": [
          "warn",
          {
            "maxNumericValue": 3400
          }
        ],
        "unsized-images": "error",
        "image-size-responsive": "error",
        "modern-image-formats": "warn",
        "uses-optimized-images": "error",
        "offscreen-images": "warn",
        "font-display": "error",
        "render-blocking-resources": "warn",
        "unused-javascript": [
          "warn",
          {
            "maxLength": 0
          }
        ],
        "unused-css-rules": [
          "warn",
          {
            "maxLength": 0
          }
        ],
        "meta-description": "error",
        "document-title": "error",
        "html-has-lang": "error",
        "hreflang": "off",
        "structured-data": "off",
        "color-contrast": "error",
        "heading-order": "error",
        "label": "error",
        "link-name": "error",
        "button-name": "error",
        "image-alt": "error",
        "aria-allowed-attr": "error",
        "aria-required-attr": "error",
        "is-on-https": "off",
        "csp-xss": "off",
        "errors-in-console": "error",
        "no-vulnerable-libraries": "off",
        "deprecations": "error",
        "canonical": "off",
        "network-dependency-tree-insight": "warn",
        "legacy-javascript-insight": "warn"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
